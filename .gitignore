# Dependencies
node_modules/
server/node_modules/

# Environment secrets — NEVER commit these
.env
.env.local
.env.production
.env.*.local

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
*.egg-info/
dist/
build/
*.egg

# ML binary artifacts — retrain on server, don't bloat repo
# (joblib models are regenerated by train_asd_models.py and train_multi_disorder.py)
ml/artifacts/*.joblib

# server/public: build artifact directory (copied fresh by build.cjs on Render)
# Gitignore most of its subdirectories since they duplicate source files
# EXCEPTION: the static frontend files (pages, css, js, data) are committed
# so Render can serve them even if build.cjs fails.
server/public/ml/
# Also gitignore large data/training files from server/public
server/public/ml/data/*.csv
server/public/ml/data/*.json
server/public/ml/training/
server/public/ml/inference/
server/public/ml/artifacts/*.joblib
server/public/ml/artifacts/*.pkl
# so Render can load them without re-training on every deploy.
# The .pkl models are also committed.
# Keep all JSON metrics, feature lists, and model binaries in git:
!server/ml_artifacts/*.joblib
!server/ml_artifacts/*.pkl
!server/ml_artifacts/*.json

# Keep JSON metrics and audit files in git (small, useful for CI)
!ml/artifacts/*.json

# OS junk
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage / test output
coverage/
.nyc_output/

# Temp files
*.tmp
*.temp
.cache/


# Raw datasets — kept locally, not committed to git
ml/data/datasets/
ml/data/ssd_audio/
ml/data/raw_datasets/
