# Dependencies
node_modules/
server/node_modules/

# Environment secrets — NEVER commit these
.env
.env.local
.env.production
.env.*.local

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
*.egg-info/
dist/
build/
*.egg

# ML binary artifacts — retrain on server, don't bloat repo
# (joblib models are regenerated by train_asd_models.py and train_multi_disorder.py)
ml/artifacts/*.joblib

# Keep JSON metrics and audit files in git (small, useful for CI)
!ml/artifacts/*.json

# OS junk
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage / test output
coverage/
.nyc_output/

# Temp files
*.tmp
*.temp
.cache/
