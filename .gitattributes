# Normalise line endings for cross-platform consistency
* text=auto

# Force LF for source files on all platforms
*.js      text eol=lf
*.py      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.env     text eol=lf
*.example text eol=lf

# Binary files — no line-ending normalisation
*.joblib binary
*.png    binary
*.jpg    binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
