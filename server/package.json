{
  "name": "neuroscan-server",
  "version": "1.0.0",
  "description": "NeuroScan AI — Express + MongoDB backend API",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start":   "node server.js",
    "dev":     "node --watch server.js",
    "seed":    "node seed.js",
    "build":   "node -e \"const fs=require('fs'),path=require('path');const src=path.join(__dirname,'ml_artifacts');const dst=path.join(__dirname,'..','ml','artifacts');if(!fs.existsSync(dst)){fs.mkdirSync(dst,{recursive:true})}fs.readdirSync(src).forEach(f=>{fs.copyFileSync(path.join(src,f),path.join(dst,f));console.log('Copied',f,'to ml/artifacts/')});\""
  },
  "dependencies": {
    "@google/genai":    "^2.21.0",
    "cors":             "^2.8.5",
    "dotenv":           "^16.4.5",
    "express":          "^4.19.2",
    "firebase-admin":   "^12.1.0",
    "mongodb":          "^6.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
