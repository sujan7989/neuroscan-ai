# Server Configuration
PORT=3000

# Google Gemini API
GEMINI_API_KEY=

# MongoDB Database (Optional - in-memory fallback enabled if not set)
MONGO_URI=
DB_NAME=neuroscan

# Firebase Admin Service Account (Optional - demo/dev fallback enabled if not set)
# Provide the full JSON of your service account key, stringified
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase CLIENT-SIDE Configuration (served via /api/config — never hardcode in source)
# Find these values in Firebase Console → Project Settings → Your apps → Web app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Application Security & URLs
ADMIN_SECRET_KEY=
FRONTEND_URL=
